# ---- 存储 ----
# 开发/生产统一用 Postgres（先 `docker compose up -d pgvector`，本机 5433 暴露）：
APP_DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5433/agent
# 测试自动用 SQLite（tests/conftest.py 覆盖），无需手改
# 空 = 进程内锁（单实例开发）；生产填 Redis：
APP_REDIS_URL=

# ---- LLM ----
# mock = 本地确定性模型（离线演示/测试）；openai = OpenAI 兼容 /chat/completions 端点
APP_LLM_PROVIDER=mock
APP_LLM_BASE_URL=
APP_LLM_API_KEY=
APP_LLM_MODEL=mock-model
APP_LLM_TIMEOUT_S=30

# ---- Runtime 预算默认值（可被 run 覆盖）----
APP_BUDGET_MAX_STEPS=30
APP_BUDGET_MAX_TOKENS=200000
APP_BUDGET_MAX_COST=10.0
APP_BUDGET_MAX_TOOL_CALLS=50
APP_BUDGET_MAX_RUNTIME_S=600
APP_BUDGET_MAX_RETRIES=3

# ---- 可观测性 ----
# 空 = 无导出（console/log）；生产填 OTLP HTTP 端点
APP_OTLP_ENDPOINT=
APP_SERVICE_NAME=agent-platform

# ---- 种子身份（默认租户/用户/Agent）----
APP_SEED_TENANT=tenant-default
APP_SEED_USER=user-default

# ---- 沙箱（§23.4）----
# 生产可开容器隔离：自定义工具跑 Docker（--network none），需 docker CLI + python:3.12-slim 镜像
APP_SANDBOX_DOCKER=false
# gVisor runtime："runsc"（需安装 runsc 并在 /etc/docker/daemon.json 注册后再开）
APP_SANDBOX_DOCKER_RUNTIME=

# ---- 认证与安全（对外产品：prod 必须配置）----
# 环境：dev / test / prod。prod 会强制 auth_require_jwt、拒绝默认 JWT secret
APP_ENVIRONMENT=dev
# JWT 签名密钥：prod 必须改为强随机值（compose 会用 :? 强制要求）
APP_AUTH_JWT_SECRET=dev-secret-change-me
# 强制无有效 Bearer 拒绝（prod 自动开启，这里可显式设 true）
APP_AUTH_REQUIRE_JWT=false
# 密钥加密主密钥（§6.5）：为空则从 APP_AUTH_JWT_SECRET 派生；prod 建议独立设置
APP_SECRET_ENCRYPTION_KEY=
